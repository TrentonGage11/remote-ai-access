# Usage ledger and optional per-million-token pricing. Unknown models remain unpriced.
USAGE_LEDGER_PATH=
USAGE_PRICING_JSON={}
USAGE_MONTHLY_WARNING_TOKENS=0
USAGE_MONTHLY_HARD_LIMIT_TOKENS=0
USAGE_MONTHLY_WARNING_USD=0
USAGE_MONTHLY_HARD_LIMIT_USD=0
RUNTIME_METRIC_HISTORY_LIMIT=180
# Server
PORT=8787
HOST=127.0.0.1
# Optional provider to open by default. It must also have a configured inference key.
# Supported values: openai, copilot, google, xai, deepseek, anthropic, together, openrouter
DEFAULT_PROVIDER=openai
# Optional canonical public origin, for example https://ai.example.com.
# Leave blank to derive it from trusted reverse-proxy headers.
APP_BASE_URL=
# API request throttle for all /api routes
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=3000
# Long-running async jobs and provider retry policy
CHAT_JOB_MAX_CONCURRENT=2
CHAT_JOB_MAX_AGE_MS=21600000
# Durable queued, active, and completed agent jobs
CHAT_JOB_DB_PATH=./sandbox/_admin/chat-jobs.json
# Server-backed browser chat archives. Archives are client-encrypted before upload.
CHAT_ARCHIVE_ROOT=./sandbox/_admin/chat-archives
CHAT_ARCHIVE_MAX_BYTES=20971520
# Optional queue fairness controls. JSON values override the default by workspace code.
CHAT_JOB_DEFAULT_WORKSPACE_CONCURRENT=2
CHAT_JOB_WORKSPACE_CONCURRENCY_JSON={}
PROVIDER_REQUEST_TIMEOUT_MS=1800000
PROVIDER_MAX_RETRIES=5
PROVIDER_RETRY_BASE_MS=1000
PROVIDER_RETRY_MAX_MS=60000
# Bound compatible-provider agent transcripts so repeated tool steps do not exhaust input-token-per-minute quotas.
COMPATIBLE_AGENT_CONTEXT_MAX_CHARS=64000
COMPATIBLE_AGENT_TOOL_OUTPUT_MAX_CHARS=4000
# Durable Saved Recipe schedules
AGENT_RECIPE_SCHEDULE_DB_PATH=./sandbox/_admin/agent-recipe-schedules.json

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional: restrict selectable/requestable models, comma-separated
# Example: OPENAI_ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-4.1
OPENAI_ALLOWED_MODELS=

# xAI Grok provider (optional)
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_IMAGE_MODEL=grok-imagine-image
# Optional override for xAI-compatible endpoint
XAI_API_BASE_URL=https://api.x.ai/v1
# Optional: restrict selectable/requestable xAI models, comma-separated
# Example: XAI_ALLOWED_MODELS=grok-4.6,grok-4.5,grok-build-0.1
XAI_ALLOWED_MODELS=

# Google AI provider (optional)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.7-flash
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_NATIVE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional override for Google OpenAI-compatible endpoint
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Optional: restrict selectable/requestable Google models, comma-separated
# Example: GOOGLE_ALLOWED_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.1-pro-preview
GOOGLE_ALLOWED_MODELS=

# DeepSeek provider (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# Optional: restrict selectable/requestable DeepSeek models, comma-separated
# Example: DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash,deepseek-v4-pro
DEEPSEEK_ALLOWED_MODELS=
# Models explicitly allowed to use server-side Agent Tools (defaults to DEEPSEEK_MODEL)
DEEPSEEK_AGENT_MODELS=

# Anthropic Claude provider (optional)
# ANTHROPIC_CLAUDE_API_KEY is accepted as a backward-compatible inference-key alias.
# Anthropic Admin API keys are intentionally not accepted for inference.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096
# Optional: restrict selectable/requestable Anthropic models, comma-separated
# Example: ANTHROPIC_ALLOWED_MODELS=claude-sonnet-5,claude-opus-5,claude-haiku-4-5
ANTHROPIC_ALLOWED_MODELS=

# Together AI provider (optional)
# TOGETHER_AI_API_KEY is accepted as a backward-compatible alias.
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
TOGETHER_API_BASE_URL=https://api.together.ai/v1
# Optional: restrict selectable/requestable Together models, comma-separated
# Example: TOGETHER_ALLOWED_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo,Qwen/Qwen3-Coder-480B-A35B-Instruct-FP8
TOGETHER_ALLOWED_MODELS=
# Models explicitly allowed to use server-side Agent Tools (defaults to TOGETHER_MODEL)
TOGETHER_AGENT_MODELS=

# OpenRouter provider (optional)
# OPEN_ROUTER_API_KEY is accepted as a backward-compatible alias.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=Remote AI Access
# Optional: restrict selectable/requestable OpenRouter models, comma-separated
# Example: OPENROUTER_ALLOWED_MODELS=anthropic/claude-sonnet-5,openai/gpt-5.6-sol,google/gemini-3.8-flash
OPENROUTER_ALLOWED_MODELS=
# Models explicitly allowed to use server-side Agent Tools (defaults to OPENROUTER_MODEL)
OPENROUTER_AGENT_MODELS=

# Copilot/GitHub Models provider (optional)
GITHUB_PAT=
COPILOT_MODEL=openai/gpt-4.1
COPILOT_ALLOWED_MODELS=
# Optional override for GitHub Models inference endpoint
COPILOT_API_BASE_URL=https://models.github.ai/inference
# Optional API version header value
COPILOT_API_VERSION=2026-03-10

# File Lab sandbox (optional)
# All file APIs are constrained to this folder and auto-tracked with git.
SANDBOX_ROOT=./sandbox
FILE_API_MAX_READ_BYTES=1048576
FILE_API_UPLOAD_MAX_BYTES=20971520
FILE_API_CHUNK_UPLOAD_THRESHOLD_BYTES=67108864
FILE_API_CHUNK_SIZE_BYTES=4194304
FILE_API_CHUNK_SESSION_MAX_AGE_MS=7200000
# Public File Lab shares. Set a long random secret to enable encrypted snapshots.
FILE_SHARE_DB_PATH=./sandbox/_admin/file-shares.json
FILE_SHARE_DATA_ROOT=./sandbox/_admin/file-share-data
FILE_SHARE_ENCRYPTION_SECRET=
VIDEO_PREVIEW_TRANSCODE_TIMEOUT_MS=7200000
# Optional: disable upload size limit for specific workspaces when code matches X-Upload-Bypass-Code.
# Format: workspace:secret,workspace2:secret2
# Example: WORKSPACE_UPLOAD_BYPASS_CODES=gage-flatsat-ws0:only-i-know-this
WORKSPACE_UPLOAD_BYPASS_CODES=
SANDBOX_GIT_USER_NAME=Remote AI Access
SANDBOX_GIT_USER_EMAIL=remote-ai-access@local

# Workspace access and isolation
# Access code can come from the X-Workspace-Code header or HttpOnly workspace cookie.
WORKSPACE_COOKIE_NAME=raa_workspace
DEFAULT_WORKSPACE_CODE=default
# Optional allow-list. Leave empty to allow any valid workspace code.
# WORKSPACE_ACCESS_CODES=default,alice,boris
WORKSPACE_ACCESS_CODES=

# Optional automatic per-day session branch checkout per workspace
ENABLE_AUTO_SESSION_BRANCH=false
SESSION_BRANCH_PREFIX=session

# Optional nightly backup of each workspace git repo using git bundles
ENABLE_NIGHTLY_WORKSPACE_BACKUP=true
WORKSPACE_BACKUP_ROOT=./sandbox/_backups
WORKSPACE_BACKUP_UTC_HOUR=3
WORKSPACE_BACKUP_RETENTION_DAYS=21

# Optional workspace bare git remotes for fast external push/pull workflows
# Bare repos are created as <workspace>.git under this root.
WORKSPACE_GIT_REMOTE_ROOT=./sandbox/workspace-remotes
WORKSPACE_GIT_REMOTE_NAME=origin
# SSH URL helper shown by API. Set host to your SSH endpoint (IP/DNS) and user.
WORKSPACE_GIT_SSH_HOST=
WORKSPACE_GIT_SSH_USER=root

# Optional terminal runtime mode: host or docker
TERMINAL_RUNTIME=host
TERMINAL_DOCKER_IMAGE=node:20-bookworm
TERMINAL_DOCKER_MEMORY=1g
TERMINAL_DOCKER_CPUS=1.0
TERMINAL_DOCKER_PIDS_LIMIT=256
TERMINAL_DOCKER_NETWORK=bridge
TERMINAL_DOCKER_ALLOWED_IMAGES=node:20-bookworm,node:20,python:3-bookworm,python:3-slim-bookworm,golang:bookworm,golang:alpine,rust:bookworm,rust:slim-bookworm,kalilinux/kali-rolling,kalilinux/kali-last-release,parrotsec/core,parrotsec/security,blackarchlinux/blackarch,emscripten/emsdk,ghcr.io/webassembly/wasi-sdk,dockcross/linux-x64,dockcross/linux-x64-clang,dockcross/linux-arm64,dockcross/linux-armv7,dockcross/linux-armv7l,dockcross/linux-i686,dockcross/linux-ppc64le,dockcross/linux-riscv64,dockcross/linux-s390x,dockcross/android-arm64,dockcross/android-x86_64,dockcross/web-wasm,dockcross/web-wasi,dockcross/web-wasi-threads,dockcross/windows-static-x64,dockcross/windows-static-x64-posix,dockcross/windows-shared-x64,dockcross/windows-shared-x64-posix,dockcross/windows-static-x86,dockcross/windows-shared-x86,dockcross/windows-arm64,dockcross/manylinux_2_28-x64,messense/rust-musl-cross:x86_64-musl,mstorsjo/llvm-mingw,silkeh/clang:18,llvm/llvm:18,mcr.microsoft.com/dotnet/sdk:8.0,quay.io/pypa/manylinux_2_28_x86_64,quay.io/pypa/manylinux_2_28_aarch64,quay.io/pypa/musllinux_1_2_x86_64,quay.io/pypa/musllinux_1_2_aarch64,ubuntu:24.04,debian:bookworm-slim,alpine:latest,fedora:latest,archlinux:latest,osxcross,valgrind
# Commands in this list run on host even when TERMINAL_RUNTIME=docker
# (useful for host-installed tools like 7z or custom binaries).
TERMINAL_HOST_FALLBACK_COMMANDS=7z,7za,7zr,vfa
# Optional explicit VFA executable path (absolute or project-relative).
# Example: TERMINAL_VFA_COMMAND=../VFA/bin/vfa
TERMINAL_VFA_COMMAND=
# Fallback script used by `vfa` command when TERMINAL_VFA_COMMAND is unset.
TERMINAL_VFA_SCRIPT=../VFA/vfa.py

# Agent tool-calling loop (configured providers with Agent Tools support)
# Increase for multi-action prompts (e.g. unzip + edit + create in one request)
AGENT_MAX_STEPS=16
# Internal safety cap for AGENT_MAX_STEPS and AGENT_MAX_STEPS_OVERRIDE_LIMIT.
# Set higher if you intentionally need very long multi-tool runs.
AGENT_MAX_STEPS_HARD_LIMIT=1024
# Optional: permit per-chat step overrides when unlock code is provided by client.
# Example: AGENT_MAX_STEPS_OVERRIDE_CODE=your-secret-code
AGENT_MAX_STEPS_OVERRIDE_CODE=
# Optional workspace-specific high-step unlocks (workspace:code CSV); overrides the global code per workspace.
WORKSPACE_AGENT_STEP_OVERRIDE_CODES=
# Hard upper bound for per-chat overrides.
AGENT_MAX_STEPS_OVERRIDE_LIMIT=40
AGENT_WEB_TIMEOUT_MS=16000
# Agent Reach capability layer (optional). Defaults match the production install layout.
AGENT_REACH_HOME=/var/lib/remote-ai-access
AGENT_REACH_BIN=/opt/agent-reach/venv/bin/agent-reach
AGENT_REACH_MCPORTER_BIN=/opt/agent-reach/npm/bin/mcporter
AGENT_REACH_YTDLP_BIN=/opt/agent-reach/venv/bin/yt-dlp
AGENT_REACH_TIMEOUT_MS=45000
# Optional for YouTube transcript access when a VPS IP receives a bot challenge.
AGENT_REACH_PROXY=
AGENT_REACH_YOUTUBE_COOKIES_FILE=

# Dry-run deployment manifest validation. Empty suffixes disable the tool.
DEPLOYMENT_ALLOWED_SUFFIXES=
DEPLOYMENT_ALLOWED_RUNTIMES=static,node-service
# Comma-separated names only; secret values remain server-side.
DEPLOYMENT_ALLOWED_ENV_NAMES=
DEPLOYMENT_PREVIEW_PORT=8900
# Durable hashed one-time approvals; token plaintext is never stored.
DEPLOYMENT_APPROVAL_DB_PATH=./sandbox/_admin/deployment-approvals.json
# Root-owned static activation helper. The app receives socket access only.
DEPLOYMENT_HELPER_SOCKET_PATH=/run/raa-deploy/helper.sock
DEPLOYMENT_HELPER_TIMEOUT_MS=30000

# Optional: lock down the app with one shared login
ENABLE_BASIC_AUTH=false
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-this-password
# Optional explicit signing key for /basic-auth browser sessions. Use a long random value in production.
BASIC_AUTH_SESSION_SECRET=
BASIC_AUTH_SESSION_TTL_MS=43200000

# Optional: API key protection for selected endpoints (for scripts/external callers)
# Example: set ENABLE_API_KEY_AUTH=true and provide one or more keys in API_KEYS.
ENABLE_API_KEY_AUTH=false
API_KEYS=
API_KEY_HEADER_NAME=x-api-key
API_KEY_REQUIRE_HEADER_ONLY=true
# Comma-separated path prefixes that require API key auth.
# Default protects files, workspace git push/pull, tests, and notifications.
API_KEY_PROTECTED_PATH_PREFIXES=/api/files,/api/session/workspace/git,/api/tests,/api/notifications
# Optional bypass prefixes within protected paths (usually leave empty).
API_KEY_EXEMPT_PATH_PREFIXES=

# Admin security dashboard and settings DB (for managing keys/codes at runtime)
ADMIN_DASHBOARD_TOKEN=
ADMIN_SETTINGS_DB_PATH=./sandbox/_admin/settings-db.json

# Optional: comma-separated allowlist of origins for /api/chat
# Example: https://your-allowed-domain.com,https://www.your-allowed-domain.com
ALLOWED_ORIGINS=
