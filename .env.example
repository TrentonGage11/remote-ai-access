# Server
PORT=8787
APP_BASE_URL=http://localhost:8787
DEFAULT_PROVIDER=ollama

# Local Ollama provider
# Pull at least one model first, for example:
#   ollama pull gemma3:4b
#   ollama pull gemma3:12b
OLLAMA_COMMAND=ollama
OLLAMA_HOST=127.0.0.1:11434
# Optional default local model. Leave empty to use the selected UI model.
OLLAMA_MODEL=
# Optional: restrict selectable/requestable local models, comma-separated.
# Example: OLLAMA_ALLOWED_MODELS=gemma3:4b,gemma3:12b,gpt-oss:20b
OLLAMA_ALLOWED_MODELS=

# OpenAI provider (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: restrict selectable/requestable models, comma-separated
# Example: OPENAI_ALLOWED_MODELS=gpt-5.5,gpt-5.3-codex,gpt-4.1
OPENAI_ALLOWED_MODELS=

# xAI Grok provider (optional)
XAI_API_KEY=
XAI_MODEL=grok-4.3
# Optional override for xAI-compatible endpoint
XAI_API_BASE_URL=https://api.x.ai/v1
# Optional: restrict selectable/requestable xAI models, comma-separated
# Example: XAI_ALLOWED_MODELS=grok-4.3,grok-build-0.1
XAI_ALLOWED_MODELS=

# Copilot/GitHub Models provider (optional)
GITHUB_PAT=your_github_pat_here
# Optional override for GitHub Models inference endpoint
COPILOT_API_BASE_URL=https://models.github.ai/inference
# Optional API version header value
COPILOT_API_VERSION=2026-03-10

# File Lab sandbox (optional)
# All file APIs are constrained to this folder and auto-tracked with git.
SANDBOX_ROOT=./sandbox
FILE_API_MAX_READ_BYTES=1048576
FILE_API_UPLOAD_MAX_BYTES=20971520
FILE_API_CHUNK_UPLOAD_THRESHOLD_BYTES=67108864
FILE_API_CHUNK_SIZE_BYTES=4194304
FILE_API_CHUNK_SESSION_MAX_AGE_MS=7200000
# Optional: disable upload size limit for specific workspaces when code matches X-Upload-Bypass-Code.
# Format: workspace:secret,workspace2:secret2
# Example: WORKSPACE_UPLOAD_BYPASS_CODES=gage-flatsat-ws0:only-i-know-this
WORKSPACE_UPLOAD_BYPASS_CODES=
SANDBOX_GIT_USER_NAME=Remote AI Access
SANDBOX_GIT_USER_EMAIL=remote-ai-access@local

# Workspace access and isolation
# Access code can come from query (access_code/workspace/code), header X-Workspace-Code, or cookie.
WORKSPACE_COOKIE_NAME=raa_workspace
DEFAULT_WORKSPACE_CODE=default
# Optional allow-list. Leave empty to allow any valid workspace code.
# WORKSPACE_ACCESS_CODES=default,alice,boris
WORKSPACE_ACCESS_CODES=

# Optional automatic per-day session branch checkout per workspace
ENABLE_AUTO_SESSION_BRANCH=false
SESSION_BRANCH_PREFIX=session

# Optional nightly backup of each workspace git repo using git bundles
ENABLE_NIGHTLY_WORKSPACE_BACKUP=true
WORKSPACE_BACKUP_ROOT=./sandbox/_backups
WORKSPACE_BACKUP_UTC_HOUR=3
WORKSPACE_BACKUP_RETENTION_DAYS=21

# Optional workspace bare git remotes for fast external push/pull workflows
# Bare repos are created as <workspace>.git under this root.
WORKSPACE_GIT_REMOTE_ROOT=./sandbox/workspace-remotes
WORKSPACE_GIT_REMOTE_NAME=origin
# SSH URL helper shown by API. Set host to your SSH endpoint (IP/DNS) and user.
WORKSPACE_GIT_SSH_HOST=
WORKSPACE_GIT_SSH_USER=root

# Optional terminal runtime mode: host or docker
TERMINAL_RUNTIME=host
TERMINAL_DOCKER_IMAGE=node:20-bookworm
TERMINAL_DOCKER_MEMORY=1g
TERMINAL_DOCKER_CPUS=1.0
TERMINAL_DOCKER_PIDS_LIMIT=256
TERMINAL_DOCKER_NETWORK=bridge
TERMINAL_DOCKER_ALLOWED_IMAGES=node:20-bookworm,node:20,python:3-slim-bookworm,debian:bookworm-slim,alpine:latest,ubuntu:24.04
# Commands in this list run on host even when TERMINAL_RUNTIME=docker
# (useful for host-installed tools like 7z or custom binaries).
TERMINAL_HOST_FALLBACK_COMMANDS=7z,7za,7zr,vfa
# Optional explicit VFA executable path (absolute or project-relative).
# Example: TERMINAL_VFA_COMMAND=../VFA/bin/vfa
TERMINAL_VFA_COMMAND=
# Fallback script used by `vfa` command when TERMINAL_VFA_COMMAND is unset.
TERMINAL_VFA_SCRIPT=../VFA/vfa.py

# Agent tool-calling loop (OpenAI only)
# Increase for multi-action prompts (e.g. unzip + edit + create in one request)
AGENT_MAX_STEPS=16
# Internal safety cap for AGENT_MAX_STEPS and AGENT_MAX_STEPS_OVERRIDE_LIMIT.
# Set higher if you intentionally need very long multi-tool runs.
AGENT_MAX_STEPS_HARD_LIMIT=1024
# Optional: permit per-chat step overrides when unlock code is provided by client.
# Example: AGENT_MAX_STEPS_OVERRIDE_CODE=your-secret-code
AGENT_MAX_STEPS_OVERRIDE_CODE=
# Hard upper bound for per-chat overrides.
AGENT_MAX_STEPS_OVERRIDE_LIMIT=40
AGENT_WEB_TIMEOUT_MS=8000

# Optional: lock down the app with one shared login
ENABLE_BASIC_AUTH=false
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-this-password

# Optional: API key protection for selected endpoints (for scripts/external callers)
# Example: set ENABLE_API_KEY_AUTH=true and provide one or more keys in API_KEYS.
ENABLE_API_KEY_AUTH=false
API_KEYS=
API_KEY_HEADER_NAME=x-api-key
API_KEY_REQUIRE_HEADER_ONLY=true
# Comma-separated path prefixes that require API key auth.
# Default protects files, workspace git push/pull, tests, and notifications.
API_KEY_PROTECTED_PATH_PREFIXES=/api/files,/api/session/workspace/git,/api/tests,/api/notifications
# Optional bypass prefixes within protected paths (usually leave empty).
API_KEY_EXEMPT_PATH_PREFIXES=

# Admin security dashboard and settings DB (for managing keys/codes at runtime)
ADMIN_DASHBOARD_TOKEN=
ADMIN_SETTINGS_DB_PATH=./sandbox/_admin/settings-db.json

# Optional: comma-separated allowlist of origins for /api/chat
# Example: https://your-allowed-domain.com,https://www.your-allowed-domain.com
ALLOWED_ORIGINS=
